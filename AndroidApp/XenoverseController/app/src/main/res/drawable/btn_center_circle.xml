<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#107C10" />
            <stroke android:width="1.5dp" android:color="#88FFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#0C0C0E" />
                </shape>
            </item>
            <item android:inset="1.5dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#323238"
                        android:endColor="#1B1B1F"
                        android:type="linear" />
                    <stroke android:width="1dp" android:color="#4DFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
