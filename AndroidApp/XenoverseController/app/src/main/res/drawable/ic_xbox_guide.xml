<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="44dp"
    android:height="44dp"
    android:viewportWidth="44"
    android:viewportHeight="44">

    <!-- Outer ambient white glow halo -->
    <path android:pathData="M22,1 A21,21 0 1,1 21.9,1 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="22"
                android:centerY="22"
                android:gradientRadius="21"
                android:type="radial">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.72" android:color="#66FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dark metallic outer bezel ring -->
    <path
        android:fillColor="#141418"
        android:strokeColor="#5A5A66"
        android:strokeWidth="1.2"
        android:pathData="M22,4 A18,18 0 1,1 21.9,4 Z" />

    <!-- Illuminated pearl-white Xbox Guide sphere -->
    <path android:pathData="M22,6.5 A15.5,15.5 0 1,1 21.9,6.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="19"
                android:centerY="17"
                android:gradientRadius="16"
                android:type="radial">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.7" android:color="#F0F2F5" />
                <item android:offset="1.0" android:color="#CFD4DC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Iconic Xbox 'X' swoosh cuts inside the glowing sphere -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1B1B1F"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:pathData="M13,12 C17,15.5 22,21.5 31,31" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1B1B1F"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:pathData="M31,12 C27,15.5 22,21.5 13,31" />
</vector>
