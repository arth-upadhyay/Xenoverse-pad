<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#17171B"
                android:endColor="#101013"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#2E2E36" />
        </shape>
    </item>
</layer-list>
