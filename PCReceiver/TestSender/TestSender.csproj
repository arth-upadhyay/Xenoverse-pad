<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TestSender</RootNamespace>
    <AssemblyName>TestSender</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Share the single source of truth for the wire format with the receiver. -->
  <ItemGroup>
    <Compile Include="..\PacketProtocol.cs" Link="PacketProtocol.cs" />
  </ItemGroup>

</Project>
